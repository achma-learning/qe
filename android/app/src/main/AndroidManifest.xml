<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission: the whole question bank is bundled as an
      offline asset and rendered in a local WebView. Tapping an external
      link (Data page resources, playlist links, etc.) hands off to the
      user's browser via ACTION_VIEW, which needs no permission here.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The high-yield PDFs/.docx live inside the APK, where no other app can
          read them. Tapping one copies it to our cache dir and hands that copy
          to a viewer as a content:// URI — a file:// one would throw
          FileUriExposedException on API 24+. Not exported: access is granted
          per-intent via FLAG_GRANT_READ_URI_PERMISSION.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
